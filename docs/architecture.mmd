%%{init: {"flowchart": {"defaultRenderer": "elk"}} }%%
flowchart TD
    USER["👤 User"] --> CLI["yano CLI"]
    CLI --> INIT["init / doctor / start"]
    INIT --> HERDR_INIT["init --herdr\nHerdr workspace + root pane"]
    CLI --> OBS["status / fleet / deps / gantt / watch / trace"]
    CLI --> RELOAD["update --reload\ncontrolled restart"]
    INIT --> PLANNER["pi planner\nrole + instance identity"]
    HERDR_INIT --> PLANNER

    subgraph CONFIG["Project configuration"]
        ROLES["agents/roles.yaml\ncapabilities + playbook defaults"]
        AGENTS["agents/agents.yaml\ninstance overrides"]
        PROMPTS["prompts/\nrole instructions"]
        TO_TICKETS["to-tickets\nvertical slices + blockers"]
        REVIEW_SKILL["yano-code-review\nSpec + Standards adapter"]
        MCP[".mcp.json\nproject-wide MCP declarations"]
    end

    PLANNER --> ROLES
    PLANNER --> AGENTS
    PLANNER --> PROMPTS
    PLANNER --> TO_TICKETS
    REVIEWER --> REVIEW_SKILL
    FRONTEND_REVIEWER --> REVIEW_SKILL
    PLANNER --> MCP

    subgraph BUS["MQTT 5 — pi/<project>/..."]
        PRESENCE["retained presence + LWT"]
        COMMANDS["instance commands\nrole task fan-out"]
        RESPONSES["responses + wake-ups"]
        EVENTS["run and team events"]
    end

    PLANNER <--> PRESENCE
    PLANNER <--> COMMANDS
    PLANNER <--> RESPONSES
    PLANNER --> EVENTS

    subgraph WORKERS["Worker instances"]
        CODER["coder"]
        REVIEWER["reviewer"]
        FRONTEND_DEV["frontend-developer"]
        FRONTEND_REVIEWER["frontend-reviewer"]
        SPECIALISTS["specialists\nsecurity / docs / QA / platform / data"]
    end

    COMMANDS --> CODER
    COMMANDS --> REVIEWER
    COMMANDS --> FRONTEND_DEV
    COMMANDS --> FRONTEND_REVIEWER
    COMMANDS --> SPECIALISTS
    CODER --> RESPONSES
    REVIEWER --> RESPONSES
    FRONTEND_DEV --> RESPONSES
    FRONTEND_REVIEWER --> RESPONSES
    SPECIALISTS --> RESPONSES
    CODER --> PRESENCE
    REVIEWER --> PRESENCE
    FRONTEND_DEV --> PRESENCE
    FRONTEND_REVIEWER --> PRESENCE
    SPECIALISTS --> PRESENCE

    subgraph STORAGE["Durable project workspace"]
        SQLITE["SQLite orchestrator.db\nruns / specs / tickets / DAG\nPlaybooks / holds / evidence / outbox"]
        WORKTREES[".worktrees/<slug>\nGit isolated branches"]
        REPORTS[".pi/.../reports\nround evidence"]
    end

    subgraph GLOBAL_TRACE["Global Yano installation / temp"]
        TRACE["traces/<project-key>/events\nJSONL forensic trace\nevents / standard / full"]
        TRACE_ANALYSIS["feedback / summaries / opinions\nfiltered context + cross-project overview"]
        TRACE_INDEX["semantic-index.sqlite\ntrace_documents + Ollama embeddings\nhybrid filtered search"]
        TRACE_MEMORY["trace_memories\nepisodic failures/opinions/summaries\nsystemic recurring patterns"]
        TRACE_LINKS["trace_memory_links + context\nprovenance / causal evidence links"]
        PROJECTIONS["projections/\nplanner-context.json\nrecurring-failures.md"]
        TRACE_CONFIG["tracing.json\nper-project mode"]
    end

    subgraph YANO_WATCHER["Global watcher boundary"]
        WATCHER["yano-watcher\nzero-token polling + classifier"]
        WATCHER_ONCE["--once\nsingle bounded scan"]
        YANO_TICKETS["yano-orchestrator/.scratch/optimize-orchestrator/issues\nMarkdown maintenance tickets"]
        TELEGRAM["Telegram Bot API\nYano .env or yano config"]
    end

    subgraph YANO_DEBUGGER["Global debugger boundary"]
        DEBUGGER["yano-debugger\nbug intake + lifecycle"]
        DEBUG_ONCE["start --once\nread-only preflight"]
        DEBUG_DB["debugger.sqlite\nprojects / bugs / events"]
        DEBUG_WS["Herdr workspace\nyano-debugger\none tab per project"]
        ENVIRONMENTS["dev / staging / production\npaired port ranges"]
    end

    subgraph YANO_AUTO_IMPROVER["Global auto-improver boundary"]
        AUTO_IMPROVER["yano-auto-improver\nperiodic read-only audit"]
        AUTO_ONCE["run|start --once\none audit, no scheduler"]
        AUTO_DB["auto-improver.sqlite\nprojects / audits / recommendations"]
        AUTO_WS["Herdr workspace\nyano-auto-improver\none tab per project"]
        AUTO_REPORTS["temp/auto-improver\nevidence + reports"]
    end

    subgraph YANO_SUGGESTER["Global suggester boundary"]
        SUGGESTER["yano-suggester\nread-only intake + proposal"]
        SUGGESTER_ONCE["start|submit --once\nbounded test"]
        SUGGESTER_DB["suggester.sqlite\nprojects / suggestions / approvals"]
        SUGGESTER_WS["Herdr workspace\nyano-suggester\none tab per project"]
        SUGGESTER_REPORTS["temp/suggester\nevidence + reports"]
        SUGGESTER_GATE["superadmin approval gate"]
    end

    subgraph DELIVERY_AGENT["Deployment boundary"]
        DEPLOY_AGENT["deployment-agent\npreflight + release + rollback"]
        DEPLOY_PLAYBOOK["deployment-delivery\napproval/evidence gates"]
        DEV_SOURCE["~/projects/<project-name>\nsource development"]
        DOCKER_ENVS["Docker/Compose\nstaging + production"]
        RELEASE["immutable image digest\nhealthcheck + rollback"]
    end

    PLANNER --> SQLITE
    CODER --> WORKTREES
    REVIEWER --> WORKTREES
    FRONTEND_DEV --> WORKTREES
    FRONTEND_REVIEWER --> WORKTREES
    SPECIALISTS --> WORKTREES
    WORKTREES --> REPORTS
    WORKERS --> TRACE
    CLI --> TRACE_CONFIG
    TRACE_CONFIG --> TRACE
    TRACE --> TRACE_ANALYSIS
    TRACE --> TRACE_INDEX
    TRACE_ANALYSIS --> TRACE_INDEX
    TRACE --> TRACE_MEMORY
    TRACE_ANALYSIS --> TRACE_MEMORY
    TRACE_MEMORY --> TRACE_LINKS
    TRACE_MEMORY --> PROJECTIONS
    TRACE_LINKS --> TRACE_INDEX
    TRACE_INDEX --> PLANNER
    TRACE_MEMORY --> PLANNER
    PROJECTIONS --> PLANNER
    PLANNER --> TRACE_ANALYSIS
    TRACE --> WATCHER
    SQLITE --> WATCHER
    WATCHER --> YANO_TICKETS
    WATCHER --> TELEGRAM
    CLI --> WATCHER_ONCE
    WATCHER_ONCE --> WATCHER
    CLI --> DEBUGGER
    CLI --> DEBUG_ONCE
    DEBUG_ONCE --> DEBUGGER
    DEBUGGER --> DEBUG_DB
    DEBUGGER --> DEBUG_WS
    DEBUGGER --> ENVIRONMENTS
    DEBUG_DB --> TRACE
    DEBUGGER --> PLANNER
    CLI --> AUTO_IMPROVER
    CLI --> AUTO_ONCE
    AUTO_ONCE --> AUTO_IMPROVER
    AUTO_IMPROVER --> AUTO_DB
    AUTO_IMPROVER --> AUTO_WS
    AUTO_IMPROVER --> AUTO_REPORTS
    AUTO_IMPROVER --> TRACE
    AUTO_DB --> PLANNER
    AUTO_REPORTS --> PLANNER
    CLI --> SUGGESTER
    CLI --> SUGGESTER_ONCE
    SUGGESTER_ONCE --> SUGGESTER
    SUGGESTER --> SUGGESTER_DB
    SUGGESTER --> SUGGESTER_WS
    SUGGESTER --> SUGGESTER_REPORTS
    SUGGESTER_DB --> SUGGESTER_GATE
    SUGGESTER_REPORTS --> SUGGESTER_GATE
    SUGGESTER_GATE --> PLANNER
    PLANNER --> DEPLOY_AGENT
    DEPLOY_AGENT --> DEPLOY_PLAYBOOK
    DEPLOY_AGENT --> DEV_SOURCE
    DEPLOY_AGENT --> DOCKER_ENVS
    DOCKER_ENVS --> RELEASE
    DEPLOY_PLAYBOOK --> RELEASE
    SQLITE --> DASHBOARD["local read-only dashboard\nGantt + status"]
    OBS --> DASHBOARD

    subgraph DELIVERY["Delivery and recovery"]
        WATCHDOG["planner watchdog\nstall / orphan / unfinalized"]
        GATES["phase + actor + capability gates"]
        FINALIZE["finalize evidence\ncommit / tests / docs / version"]
        MERGE["worktree_finalize\nreviewed merge + push"]
        ADAPTERS["effect adapters\nWhatsApp / MQTT / external APIs"]
        BARRIER["reload barrier\nsafe point + version handshake"]
        SNAPSHOT["recovery snapshot\nSQLite/Git/trace/Herdr inventory"]
    end

    SQLITE --> WATCHDOG
    RELOAD --> BARRIER
    BARRIER --> SNAPSHOT
    SNAPSHOT --> RELOAD
    RELOAD --> FINALIZE
    SQLITE --> GATES
    GATES --> COMMANDS
    WATCHDOG --> PLANNER
    PLANNER --> FINALIZE
    FINALIZE --> MERGE
    SQLITE --> ADAPTERS
    ADAPTERS --> EVENTS

