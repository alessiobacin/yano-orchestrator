    TICKET --> TICKET_ROUTE{"Planner live?"}
    TICKET_ROUTE -- sì --> TICKET_MQTT["MQTT al Planner\nTelegram non inviato"]
    TICKET_ROUTE -- no --> TICKET_TELEGRAM["Telegram\nall'utente"]
    CLEAN["nessuna anomalia"] --> QUIET["heartbeat/log\nnessuna pagina"]
