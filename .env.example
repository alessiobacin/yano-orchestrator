# Optional notification channels. Each channel is independent: configure
# only the variables for the services you actually use.
# Evolution API / WhatsApp
# ATTENZIONE (Revisione 48 — bug reale trovato in un progetto reale che usa
# questo pacchetto): la chiave qui sotto DEVE chiamarsi EVOLUTION_INSTANCE_NAME
# (con "_NAME"), non solo EVOLUTION_INSTANCE — extensions/orchestrator.ts
# legge esattamente EVOLUTION_INSTANCE_NAME (vedi sendWhatsAppNotification());
# un .env con solo EVOLUTION_INSTANCE non attiva mai le notifiche WhatsApp.
# Per WhatsApp servono tutte e quattro le chiavi del blocco sotto. Se una
# manca, viene disattivato solo WhatsApp: Telegram e SendGrid restano autonomi.
EVOLUTION_API_URL=<your_api_url>
EVOLUTION_API_KEY=<your_api_key>
EVOLUTION_INSTANCE_NAME=<your_instance_name>
DESTINATION_PHONE_NUMBER=<your_destination_phone_number>

SENDGRID_API_KEY=<your_sendgrid_api_key>
SENDGRID_FROM_EMAIL=<your_sendgrid_from_email>
SENDGRID_TO_EMAIL=<your_sendgrid_to_email>
# Optional override for the email subject (defaults to "Yano notification"):
# SENDGRID_SUBJECT=Yano notification

# The global yano-watcher reads these two values from the Yano repository .env
# when it escalates a Yano orchestration fault (not from the watched app .env).
TELEGRAM_BOT_TOKEN=<your_telegram_bot_token>
TELEGRAM_DESTINATION_CHAT_ID=5228139669
