# This file is a development/project template. It is NOT copied into the
# global npm package and must never contain real secrets in git.
# For a global-only installation use `yano config set ...` instead.

# ── Yano watcher / maintenance ──────────────────────────────────────────────
# Optional on machines that do not maintain a local Yano checkout. When set,
# Yano watcher writes maintenance tickets here:
YANO_ORCHESTRATOR_REPO=<absolute_path_to_yano_orchestrator_checkout>

# ── Trace and semantic index ──────────────────────────────────────────────────
# Optional; otherwise the installation's temp directory is used.
# YANO_DATA_DIR=<absolute_path_to_yano_data>
# YANO_TEMP_DIR=<absolute_path_to_legacy_yano_temp>
# YANO_TRACE_MODE=events
# Ollama is used by `yano trace index` and `yano trace consolidate`.
# YANO_OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_HOST=http://127.0.0.1:11434  # alternativa legacy
# YANO_EMBEDDING_MODEL=nomic-embed-text

# ── Yano debugger REST API (optional; CLI-only if unset) ─────────────────────
# `yano debugger serve` exposes the debugger registry over HTTP. Unset means
# the default port (4177) and no auth token required (loopback-only bind).
# YANO_DEBUGGER_API_PORT=4177
# YANO_DEBUGGER_API_TOKEN=<bearer_token_for_the_debugger_rest_api>

# ── Yano auto-improve REST API (optional; CLI-only if unset) ─────────────────
# `yano auto-improve serve` exposes the auto-improver registry over HTTP. Unset
# means the default port (4178) and no auth token required (loopback-only bind).
# YANO_AUTO_IMPROVER_API_PORT=4178
# YANO_AUTO_IMPROVER_API_TOKEN=<bearer_token_for_the_auto_improver_rest_api>

# ── Yano suggester REST API (optional; CLI-only if unset) ────────────────────
# `yano suggester serve` exposes the suggester registry over HTTP. Unset means
# the default port (4179) and no auth token required (loopback-only bind).
# YANO_SUGGESTER_API_PORT=4179
# YANO_SUGGESTER_API_TOKEN=<bearer_token_for_the_suggester_rest_api>

# ── Yano model-advisor / llmProxy (optional; CLI-only, degrades to auto) ────
# `yano model-advisor` queries llmProxy's live provider catalog (cost/coding/
# latency) to recommend a pinned model per role/task. Unset means the default
# base URL below and no auth (loopback-only, no gate on llmProxy's side).
# YANO_LLMPROXY_URL=http://127.0.0.1:7045
# YANO_LLMPROXY_API_KEY=<bearer_token_for_the_llmproxy_rest_api>

# ── Runtime / MQTT tuning (all optional; defaults are safe) ──────────────────
# PI_ORCH_BROKER_URL=mqtt://127.0.0.1:1883
# PI_ORCH_AWAY=1
# PI_ORCH_MAX_HOPS=24
# PI_ORCH_TIMEOUT_MS=1800000
# PI_ORCH_HEARTBEAT_MS=15000
# PI_ORCH_STALE_AFTER_MS=45000
# PI_ORCH_WATCHDOG_INTERVAL_MS=120000
# PI_ORCH_WATCHDOG_STALL_MS=900000
# PI_ORCH_WATCHDOG_FINALIZE_GRACE_MS=600000
# PI_ORCH_WATCHDOG_AUTO_TERMINATE=false
# PI_ORCH_WATCHDOG_AUTO_TERMINATE_MS=1200000

# ── WhatsApp / Evolution API ─────────────────────────────────────────────────
# All four variables are required together; an incomplete channel is skipped.
EVOLUTION_API_URL=<your_api_url>
EVOLUTION_API_KEY=<your_api_key>
EVOLUTION_INSTANCE_NAME=<your_instance_name>
DESTINATION_PHONE_NUMBER=<your_destination_phone_number>

# ── Telegram ─────────────────────────────────────────────────────────────────
# Both variables are required together for watcher escalation and Telegram
# task notifications.
TELEGRAM_BOT_TOKEN=<your_telegram_bot_token>
TELEGRAM_DESTINATION_CHAT_ID=<your_telegram_destination_chat_id>

# ── Email / SendGrid ─────────────────────────────────────────────────────────
# All three variables are required together; recipients may be comma-separated.
SENDGRID_API_KEY=<your_sendgrid_api_key>
SENDGRID_FROM_EMAIL=<your_sendgrid_from_email>
SENDGRID_TO_EMAIL=<your_sendgrid_to_email>
# SENDGRID_SUBJECT=Yano notification

# The following are injected by Herdr/Pi or are test-only seams. Do not add
# them to a production .env unless you explicitly know why:
# HERDR_ENV, HERDR_BIN_PATH, HERDR_PANE_ID, HERDR_TAB_ID, PASEO_AGENT_ID,
# YANO_EXPECTED_TRACE_MODE, YANO_EXPECTED_YANO_VERSION,
# YANO_TELEGRAM_API_URL, YANO_WATCHER_NOTIFY_DRY_RUN.
