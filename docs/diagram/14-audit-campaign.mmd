flowchart TD
    USER["User"] --> P["Planner\nscope + variant + budget"]
    P --> M["audit-manifest.mjs\nD0 deterministic discovery\nrun once"]
    M --> C["Shared manifest\nfiles / commands / tests / tools / docs"]
    C --> T["Toolchain readiness\nCLI / MCP / skills / playbooks"]
