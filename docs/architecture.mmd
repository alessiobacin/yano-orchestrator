    end

    subgraph YANO_WATCHER["Global watcher boundary"]
        WATCHER["yano-watcher\nrole watcher\nread-only validation agent\ntab: watcher-<project-name>"]
        WATCHER_ONCE["yano watch --once / --interval-ms\nzero-token bounded scan / polling\nyano_watcher_scan timestamp event"]
