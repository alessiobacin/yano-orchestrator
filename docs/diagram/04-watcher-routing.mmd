flowchart TD
    LOOP["watcher supervise\ncron ogni minuto"] --> DB["DB + trace bounded\nticket/stato/heartbeat"]
    LOOP --> HEARTBEAT["MQTT heartbeat\nagent live"]
    LOOP --> TRACE["trace bounded\nsegnali Yano"]
    LOOP --> SERVICES["Herdr + servizi + agenti\nworkspace/tab/pane/processo"]
    LOOP --> SCHEDULES["scheduler jobs.json\nistanze failed/dispatched stale"]
    LOOP --> SCAN["yano_watcher_scan\nstarted_at / completed_at\nduration / status"]
    DB --> FINDING["finding"]
    HEARTBEAT --> FINDING
    TRACE --> FINDING
    SERVICES --> FINDING
    SCHEDULES --> FINDING
    FINDING --> PLANNER{"Planner live?"}
    PLANNER -- sì --> MQTT["comando MQTT\nal Planner"]
    PLANNER -- no --> TELEGRAM["Telegram\nconfig globale"]
    SCHEDULES --> REMEDY{"anomalia consegna?"}
