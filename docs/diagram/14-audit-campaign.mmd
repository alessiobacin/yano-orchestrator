    C --> A["Architecture health\nboundaries / coupling / duplication\nlarge files / dead-code candidates"]
    C --> O["Automation + observability\nretries / timeouts / logs / trace"]
    C --> X["Product + UX + market\ncommands / GUI / data views / competitors"]
    C --> D["AI delegation\nD0 / D1 / AI\nscript opportunities"]
    T --> R["Dependent chapters\nonly after prerequisites"]
    Q --> R
    A --> R
    O --> R
    X --> R
    D --> R
    R --> S["Audit synthesizer\ndeduplicate + preserve conflicts"]
    S --> I["Implementation DAG\norder / dependencies / parallel work"]
